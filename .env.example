# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string for the Docker Compose database (npm run db:up).
# Local development credentials only; matches docker-compose.yml (host port 5434).
DATABASE_URL="postgresql://payment:payment@localhost:5434/payment"

# Base URL of the running app. Used to build the Paystack callback_url (where the customer lands
# after paying) and for the same-origin (CSRF) check on API routes: a request whose Origin header
# differs from this is rejected. Port 3002 because 3001 is auth-slice and 3000 is used by another
# local project.
APP_URL="http://localhost:3002"

# From the Paystack dashboard, in TEST mode: Settings > API Keys & Webhooks > Test Secret Key
# (starts with sk_test_). Server-only. It does two jobs: it is the Bearer token on every Paystack
# API call, AND it is the key for the HMAC-SHA512 signature Paystack puts in the
# `x-paystack-signature` header of every webhook. There is no separate webhook secret to set.
# Never use a live key (sk_live_) here.
PAYSTACK_SECRET_KEY=""
