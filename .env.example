# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string for the Docker Compose database (npm run db:up).
# Local development credentials only; matches docker-compose.yml (host port 5434).
DATABASE_URL="postgresql://payment:payment@localhost:5434/payment"

# Base URL of the running app, used to build the Flutterwave redirect URL.
# Port 3002 because 3001 is auth-slice and 3000 is used by another local project.
APP_URL="http://localhost:3002"

# Server-only secret used to sign session cookies (same pattern as auth-slice). At least 32
# random bytes, base64url-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# From the Flutterwave dashboard, in TEST mode: Settings > API keys > Secret key.
# Starts with FLWSECK_TEST-. Server-only: used for the Bearer token on every API call.
FLUTTERWAVE_SECRET_KEY=""

# From the same Settings > API keys page: Public key (starts with FLWPUBK_TEST-).
# The hosted checkout is started server-side and may not need it; kept in case it does.
FLUTTERWAVE_PUBLIC_KEY=""

# A value YOU make up: any long random string. Enter the exact same value in the Flutterwave
# dashboard under Settings > Webhooks > Secret hash. Flutterwave sends it back in the
# `verif-hash` header of every webhook; we compare it to this. It is a shared secret, not a
# signature. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""
