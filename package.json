{
  "name": "payment-slice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "dev:webhook-gate": "tsx scripts/webhook-gate.ts",
    "check:checkout": "tsx --env-file=.env scripts/check-checkout.ts",
    "check:rate-limit": "tsx --env-file=.env scripts/check-rate-limit.ts",
    "check:checkout-return": "tsx --env-file=.env scripts/check-checkout-return.ts",
    "check:paystack": "tsx scripts/check-paystack.ts",
    "check:fulfilment": "tsx --env-file=.env scripts/check-fulfilment.ts",
    "check:webhook": "tsx --env-file=.env scripts/check-webhook.ts",
    "check:billing": "tsx --env-file=.env scripts/check-billing.ts",
    "check:cancellation": "tsx --env-file=.env scripts/check-cancellation.ts",
    "check:upgrade": "tsx --env-file=.env scripts/check-upgrade.ts",
    "// db:studio": "Fixed port 5557: 5555 is auth-slice and 5556 is used by another local project, so a shared port would cross-serve data",
    "db:studio": "prisma studio --port 5557",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
